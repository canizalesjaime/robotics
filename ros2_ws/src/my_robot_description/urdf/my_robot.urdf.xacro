<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="my_robot">


<!-- ========================= -->
<!-- Properties                -->
<!-- ========================= -->

<xacro:property name="base_length" value="0.1500"/>
<xacro:property name="base_width"  value="0.1250"/>
<xacro:property name="base_height" value="0.0508"/>

<xacro:property name="wheel_radius" value="0.0205"/>
<xacro:property name="wheel_width"  value="0.017"/>

<xacro:property name="wheel_x" value="-0.06985"/>
<xacro:property name="wheel_y" value="0.072"/>


<!-- ========================= -->
<!-- Base                      -->
<!-- ========================= -->

<link name="base_link">

    <visual>
        <geometry>
            <mesh filename="package://my_robot_description/meshes/base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="white">
            <color rgba="1 1 1 1"/>
        </material>
    </visual>

    <collision>
        <geometry>
            <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0"/>
        <inertia
            ixx="0.01"
            ixy="0"
            ixz="0"
            iyy="0.01"
            iyz="0"
            izz="0.01"/>
    </inertial>

</link>



<!-- ========================= -->
<!-- Wheels                    -->
<!-- ========================= -->


<xacro:macro name="wheel" params="name x y">

<link name="${name}">

    <visual>
        <geometry>
            <cylinder radius="${wheel_radius}"
                      length="${wheel_width}"/>
        </geometry>

        <origin rpy="1.5708 0 0"/>
    </visual>


    <collision>

        <geometry>
            <cylinder radius="${wheel_radius}"
                      length="${wheel_width}"/>
        </geometry>

        <origin rpy="1.5708 0 0"/>

    </collision>


</link>


<joint name="${name}_joint" type="continuous">

    <parent link="base_link"/>
    <child link="${name}"/>

    <origin xyz="${x} ${y} ${wheel_radius}"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

</joint>

</xacro:macro>



<xacro:wheel
    name="left_wheel"
    x="${wheel_x}"
    y="${wheel_y}"/>


<xacro:wheel
    name="right_wheel"
    x="${wheel_x}"
    y="-${wheel_y}"/>



<!-- ========================= -->
<!-- Front Caster               -->
<!-- ========================= -->


<link name="caster_link">

    <visual>
        <geometry>
            <sphere radius="0.015"/>
        </geometry>
    </visual>


    <collision>
        <geometry>
            <sphere radius="0.015"/>
        </geometry>
    </collision>


</link>


<joint name="caster_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_link"/>

    <origin xyz="0.0762 0 -0.005"
            rpy="0 0 0"/>

</joint>



<!-- ========================= -->
<!-- MPU6050 IMU               -->
<!-- ========================= -->


<link name="imu_link">

    <visual>

        <geometry>
            <box size="0.01 0.01 0.005"/>
        </geometry>

    </visual>


</link>


<joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="-0.06985 0.072 0.0459"
            rpy="0 0 0"/>

</joint>



<!-- ========================= -->
<!-- Camera                    -->
<!-- ========================= -->


<link name="camera_link">

    <visual>

        <geometry>
            <box size="0.015 0.015 0.015"/>
        </geometry>

    </visual>

</link>



<joint name="camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin xyz="0.0762 0.04445 0.075"
            rpy="0 0 0"/>

</joint>



<!-- ========================= -->
<!-- LiDAR Servo Housing       -->
<!-- ========================= -->


<link name="lidar_base_link">

    <visual>

        <geometry>
            <mesh filename="package://my_robot_description/meshes/lidar_base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

    </visual>


    <collision>

        <geometry>
            <mesh filename="package://my_robot_description/meshes/lidar_base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

    </collision>


</link>



<joint name="lidar_base_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_base_link"/>

    <origin xyz="0 0 0.075"
            rpy="0 0 0"/>

</joint>



<!-- ========================= -->
<!-- Rotating LiDAR cover      -->
<!-- ========================= -->


<link name="lidar_cover_link">

    <visual>

        <geometry>
            <mesh filename="package://my_robot_description/meshes/base_cover.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

    </visual>

</link>



<joint name="lidar_rotation_joint" type="revolute">

    <parent link="lidar_base_link"/>
    <child link="lidar_cover_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>


    <limit
        lower="-3.14159"
        upper="3.14159"
        effort="2"
        velocity="5"/>

</joint>



<!-- ========================= -->
<!-- LiDAR Sensor              -->
<!-- ========================= -->


<link name="lidar_link">

    <visual>

        <geometry>
            <cylinder radius="0.03"
                      length="0.02"/>
        </geometry>

    </visual>


</link>



<joint name="lidar_joint" type="fixed">

    <parent link="lidar_cover_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.025"
            rpy="0 0 0"/>

</joint>



</robot>